{
  "$schema_note": "Manifest for AI agents (e.g. Hermes) generating LinkedIn/IG carousel slides (1080x1080px) from these HTML templates. Fill placeholder tokens via plain string replace, then render each file to PNG (e.g. headless browser, viewport 1080x1080, screenshot the <body> element).",
  "canvas": { "width": 1080, "height": 1080 },
  "handle": "@jefry-chiedi",
  "usage_notes": [
    "Placeholders use {{TOKEN}} syntax and appear exactly once per token per file — safe for direct string replacement.",
    "max_chars values are approximate engineering estimates (font-size, line-height, container width) with safety margin, NOT hard limits enforced by the browser.",
    "Every text container has a bottom fade-mask (mask-image) as a visual overflow guard: text longer than max_chars will fade out at the bottom edge instead of clipping abruptly — treat any visible fade as a signal to shorten the text, not a rendering bug.",
    "Recommended workflow: generate copy within max_chars, render to PNG, and only escalate to a human if the fade is visibly triggered.",
    "editorial-classic and tech-grid are the safest defaults for dense/informational tech content (highest char budgets). mystic-minimal, fashion-diagonal and bold-statement have the smallest budgets — best for short, punchy statements."
  ],
  "themes": [
    {
      "id": "editorial-classic",
      "label": "Editorial Classic",
      "best_for": "Neutral, dense informational content; safest general-purpose default",
      "files": {
