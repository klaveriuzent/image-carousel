        "content": { "path": "editorial-classic/02-content.html", "placeholders": { "TITLE": { "max_chars": 40 }, "BODY_1": { "max_chars": 260 }, "BODY_2": { "max_chars": 260 }, "BODY_3": { "max_chars": 260 } } },
